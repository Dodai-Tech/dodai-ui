#!/usr/bin/env nu
# Regenerate src/material/{outlined,rounded,sharp}.rs from the official Material Symbols SVGs
# (npm `@material-symbols/svg-400`, Apache-2.0, weight 400, 24px optical size).
#
#     npm pack @material-symbols/svg-400; tar xzf material-symbols-svg-400-*.tgz
#     nu crates/dodai-icons/scripts/material/generate.nu package
#
# Each icon is stored as its SVG path data only (viewBox `0 -960 960 960`),
# sorted by name so lookups can binary-search.

def main [src: string = "package"] {
    let out = ($env.FILE_PWD | path dirname | path dirname | path join src material)
    for style in [outlined rounded sharp] {
        let rows = (
            glob ($src | path join $style "*.svg")
            | each {|f|
                let paths = (open --raw $f | parse --regex '<path d="(?P<d>[^"]*)"')
                if ($paths | is-empty) { error make { msg: $"no path in ($f)" } }
                { name: ($f | path parse | get stem), path: ($paths.d | str join) }
            }
            | sort-by name
        )
        let body = ($rows | each {|r| $"    Icon { name: \"($r.name)\", path: \"($r.path)\" },\n" } | str join)
        [
            "// @generated by scripts/generate.nu from Material Symbols (Apache-2.0). Do not edit.\n"
            "use super::Icon;\n\n"
            $"/// All ($rows | length) ($style) icons \(including `-fill` variants\), sorted by name.\n"
            "pub static ALL: &[Icon] = &[\n"
            $body
            "];\n"
            (open --raw ($env.FILE_PWD | path join style-tail.rs))
        ] | str join | save --force ($out | path join $"($style).rs")
        print $"($style) ($rows | length)"
    }
}
