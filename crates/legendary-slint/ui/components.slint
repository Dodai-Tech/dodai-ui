// Legendary UI components. All colours/shapes come from the `Theme` global
// (see theme.slint); nothing here depends on a particular theme.
import { Theme } from "theme.slint";

// Shape-aware background: chamfered Path when the theme chamfers, otherwise a
// (rounded or square) Rectangle. Optional glow driven by Theme.glow-*.
export component LFrame inherits Rectangle {
    in property <color> fill: transparent;
    in property <color> stroke: transparent;
    in property <length> stroke-width: Theme.border-width;
    in property <bool> glow: false;
    property <float> w: root.width / 1px;
    property <float> h: root.height / 1px;
    property <float> c: Math.min(Theme.chamfer / 1px, Math.min(w, h) / 3);
    property <string> d:
        (Theme.cut-tl ? "M 0 " + c + " L " + c + " 0 " : "M 0 0 ")
        + (Theme.cut-tr ? "L " + (w - c) + " 0 L " + w + " " + c + " " : "L " + w + " 0 ")
        + (Theme.cut-br ? "L " + w + " " + (h - c) + " L " + (w - c) + " " + h + " " : "L " + w + " " + h + " ")
        + (Theme.cut-bl ? "L " + c + " " + h + " L 0 " + (h - c) + " " : "L 0 " + h + " ")
        + "Z";
    if Theme.chamfered: Rectangle {
        width: parent.width;
        height: parent.height;
        drop-shadow-blur: root.glow && Theme.glow-enabled ? Theme.glow-radius : 0px;
        drop-shadow-color: Theme.glow;
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: root.w;
            viewbox-height: root.h;
            commands: root.d;
            fill: root.fill;
            stroke: root.stroke;
            stroke-width: root.stroke-width;
        }
    }
    if !Theme.chamfered: Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.fill;
        border-color: root.stroke;
        border-width: root.stroke-width;
        border-radius: Theme.radius;
        drop-shadow-blur: root.glow && Theme.glow-enabled ? Theme.glow-radius : 0px;
        drop-shadow-color: Theme.glow;
    }
    @children
}

// kind: 0 heading, 1 label, 2 muted, 3 mono, 4 body.
export component LText inherits Text {
    in property <int> kind: 4;
    in property <string> content;
    in property <bool> caps: kind <= 1 && Theme.uppercase;
    text: caps ? Theme.label-case(content) : content;
    color: kind == 2 ? Theme.text-muted : Theme.text;
    font-family: kind == 0 ? Theme.font-display : kind == 3 ? Theme.font-mono : Theme.font-body;
    font-size: kind == 0 ? Theme.size-lg : kind == 4 || kind == 3 ? Theme.size-md : Theme.size-sm;
    font-weight: kind <= 1 ? 700 : 400;
    letter-spacing: kind <= 1 ? Theme.label-tracking * self.font-size : 0px;
}

// variant: 0 primary, 1 secondary, 2 outline, 3 outline-secondary, 4 danger, 5 ghost.
export component LButton inherits Rectangle {
    in property <string> text;
    in property <int> variant: 0;
    in property <bool> enabled: true;
    callback clicked();
    property <int> idx: root.variant * 4 + (!root.enabled ? 3 : ta.pressed ? 2 : ta.has-hover ? 1 : 0);
    min-height: Theme.control-height;
    min-width: lbl.preferred-width + Theme.sp-lg * 2;
    LFrame {
        fill: Theme.button-bg[root.idx];
        stroke: Theme.button-border[root.idx];
        glow: root.enabled && (root.variant == 0 || ta.has-hover);
    }
    lbl := LText {
        kind: 1;
        content: root.text;
        color: Theme.button-fg[root.idx];
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component LPanel inherits Rectangle {
    in property <string> title;
    in property <bool> focused: false;
    min-height: 40px;
    LFrame {
        fill: Theme.panel-bg[root.focused ? 1 : 0];
        stroke: Theme.panel-border[root.focused ? 1 : 0];
        glow: root.focused;
    }
    VerticalLayout {
        padding: Theme.sp-md;
        spacing: Theme.sp-sm;
        if root.title != "": LText {
            kind: 1;
            content: root.title;
            color: Theme.panel-title[root.focused ? 1 : 0];
        }
        @children
    }
}

// tone: 0 info, 1 success, 2 warning, 3 danger.
export component LTag inherits Rectangle {
    in property <string> text;
    in property <int> tone: 0;
    in property <bool> solid: false;
    property <int> idx: root.tone * 2 + (root.solid ? 1 : 0);
    min-height: Theme.size-sm + Theme.sp-sm;
    min-width: l.preferred-width + Theme.sp-md * 2;
    LFrame { fill: Theme.tag-bg[root.idx]; stroke: Theme.tag-border[root.idx]; }
    l := LText { kind: 1; content: root.text; color: Theme.tag-fg[root.idx]; horizontal-alignment: center; vertical-alignment: center; }
}

export component LTab inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();
    property <int> idx: (root.active ? 2 : 0) + (ta.has-hover ? 1 : 0);
    min-height: Theme.control-height;
    min-width: l.preferred-width + Theme.sp-lg * 2;
    LFrame { fill: Theme.tab-bg[root.idx]; stroke: transparent; stroke-width: 0px; }
    l := LText { kind: 1; content: root.text; color: Theme.tab-fg[root.idx]; horizontal-alignment: center; vertical-alignment: center; }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.tab-indicator[root.idx];
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component LTabs inherits HorizontalLayout {
    in property <[string]> tabs;
    in-out property <int> current;
    spacing: Theme.sp-xs;
    for t[i] in root.tabs: LTab {
        text: t;
        active: i == root.current;
        clicked => { root.current = i; }
    }
}

// Switch.
export component LToggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    property <int> idx: (root.checked ? 4 : 0) + (!root.enabled ? 3 : ta.pressed ? 2 : ta.has-hover ? 1 : 0);
    min-width: Theme.control-height * 1.5;
    min-height: Theme.control-height * 0.6;
    max-height: Theme.control-height * 0.6;
    LFrame { fill: Theme.toggle-track[root.idx]; stroke: Theme.toggle-border[root.idx]; glow: root.checked && root.enabled; }
    Rectangle {
        width: parent.height - 8px;
        height: self.width;
        y: 4px;
        x: root.checked ? parent.width - self.width - 4px : 4px;
        background: Theme.toggle-thumb[root.idx];
        border-radius: Theme.radius > 0px ? self.width / 2 : 0px;
        animate x { duration: 120ms; }
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

export component LCheckbox inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    property <int> idx: (root.checked ? 4 : 0) + (!root.enabled ? 3 : ta.pressed ? 2 : ta.has-hover ? 1 : 0);
    min-height: Theme.control-height * 0.7;
    HorizontalLayout {
        spacing: Theme.sp-sm;
        Rectangle {
            width: Theme.control-height * 0.5;
            height: self.width;
            LFrame { fill: Theme.toggle-track[root.idx]; stroke: Theme.toggle-border[root.idx]; glow: root.checked && root.enabled; }
            if root.checked: Rectangle {
                width: parent.width * 0.4;
                height: self.width;
                background: Theme.toggle-thumb[root.idx];
            }
        }
        LText { content: root.text; color: root.enabled ? Theme.text : Theme.text-disabled; vertical-alignment: center; }
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.checked = !root.checked; } }
}

export component LRadio inherits Rectangle {
    in property <bool> selected;
    in property <string> text;
    callback clicked();
    property <int> idx: (root.selected ? 4 : 0) + (ta.pressed ? 2 : ta.has-hover ? 1 : 0);
    min-height: Theme.control-height * 0.7;
    HorizontalLayout {
        spacing: Theme.sp-sm;
        Rectangle {
            width: Theme.control-height * 0.5;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.toggle-track[root.idx];
            border-color: Theme.toggle-border[root.idx];
            border-width: Theme.border-width;
            if root.selected: Rectangle {
                width: parent.width * 0.4;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.toggle-thumb[root.idx];
            }
        }
        LText { content: root.text; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// tone: -1 brand, 0..3 info/success/warning/danger. value 0..1.
export component LProgress inherits Rectangle {
    in property <float> value;
    in property <int> tone: -1;
    property <int> idx: root.tone + 1;
    min-height: Theme.sp-md;
    LFrame { fill: Theme.progress-track[root.idx]; stroke: Theme.progress-border[root.idx]; }
    Rectangle {
        x: Theme.border-width;
        width: (parent.width - Theme.border-width * 2) * Math.clamp(root.value, 0, 1);
        height: parent.height - Theme.border-width * 2;
        background: Theme.progress-fill[root.idx];
        border-radius: Theme.radius > 0px ? self.height / 2 : 0px;
    }
}

export component LSlider inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    callback changed(float);
    property <float> frac: (Math.clamp(root.value, root.minimum, root.maximum) - root.minimum) / (root.maximum - root.minimum);
    min-height: Theme.control-height * 0.6;
    Rectangle {
        height: Theme.sp-sm;
        y: (parent.height - self.height) / 2;
        LFrame { fill: Theme.progress-track[0]; stroke: Theme.progress-border[0]; }
        Rectangle {
            width: parent.width * root.frac;
            background: Theme.progress-fill[0];
        }
    }
    Rectangle {
        width: Theme.control-height * 0.45;
        height: self.width;
        y: (parent.height - self.height) / 2;
        x: (parent.width - self.width) * root.frac;
        background: Theme.toggle-thumb[5];
        border-color: Theme.toggle-border[4];
        border-width: Theme.border-width;
        border-radius: Theme.radius > 0px ? self.width / 2 : 0px;
        drop-shadow-blur: Theme.glow-enabled ? Theme.glow-radius : 0px;
        drop-shadow-color: Theme.glow;
    }
    ta := TouchArea {
        function set() {
            root.value = root.minimum + Math.clamp(self.mouse-x / self.width, 0, 1) * (root.maximum - root.minimum);
            root.changed(root.value);
        }
        pointer-event(e) => { if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { self.set(); } }
        moved => { if (self.pressed) { self.set(); } }
    }
}

export component LInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    min-height: Theme.control-height;
    LFrame {
        fill: Theme.input-bg[ti.has-focus ? 1 : 0];
        stroke: Theme.input-border[ti.has-focus ? 1 : 0];
        glow: ti.has-focus;
    }
    ti := TextInput {
        x: Theme.sp-md;
        width: parent.width - Theme.sp-md * 2;
        height: parent.height;
        text <=> root.text;
        color: Theme.input-text;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.input-text;
        font-family: Theme.font-body;
        font-size: Theme.size-md;
        vertical-alignment: center;
    }
    if root.text == "" && !ti.has-focus: Text {
        x: Theme.sp-md;
        text: root.placeholder;
        color: Theme.input-placeholder;
        font-family: Theme.font-body;
        font-size: Theme.size-md;
        vertical-alignment: center;
        height: parent.height;
    }
}

export component LListItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();
    property <int> idx: (root.selected ? 2 : 0) + (ta.has-hover ? 1 : 0);
    min-height: Theme.control-height;
    Rectangle { background: Theme.list-bg[root.idx]; }
    Rectangle { x: 0px; width: 3px; background: Theme.list-marker[root.idx]; }
    LText { x: Theme.sp-md; width: parent.width - Theme.sp-md * 2; content: root.text; color: Theme.list-fg[root.idx]; vertical-alignment: center; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component LDivider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// Show on hover of a parent: `LTooltip { shown: ta.has-hover; text: "…" }`.
export component LTooltip inherits Rectangle {
    in property <string> text;
    in property <bool> shown: true;
    visible: root.shown;
    min-width: l.preferred-width + Theme.sp-md * 2;
    min-height: l.preferred-height + Theme.sp-sm * 2;
    LFrame { fill: Theme.overlay; stroke: Theme.border-strong; }
    l := LText { kind: 4; content: root.text; font-size: Theme.size-sm; horizontal-alignment: center; vertical-alignment: center; }
}

// Optional CRT scanlines; place last (on top) in a full-size container.
export component LScanlines inherits Rectangle {
    visible: Theme.scanlines;
    for i in Math.ceil(root.height / 3px): Rectangle {
        y: i * 3px;
        height: 1px;
        background: #00000030;
    }
}
