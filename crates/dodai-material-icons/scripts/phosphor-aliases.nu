# Builds src/phosphor_aliases.rs from phosphor-aliases.txt, keeping only pairs where the
# Phosphor name and the Material Symbols name both exist.
# usage: nu scripts/phosphor-aliases.nu /tmp/phosphor
def main [phosphor: string] {
  # The crate's own data is the truth for which Material names exist.
  let mat = (open src/outlined.rs | lines | where {|l| $l | str starts-with '    Icon { name: "'}
    | each {|l| $l | parse -r 'name: "(?<n>[^"]+)"' | get n.0}
    | where {|n| not ($n | str ends-with '-fill')})
  let ph = (open ($phosphor | path join src/icons.ts) | lines
    | where {|l| $l =~ '^    name: "'}
    | each {|l| $l | parse -r 'name: "(?<n>[^"]+)"' | get n.0})
  let rows = (open scripts/phosphor-aliases.txt | lines
    | where {|l| ($l | str trim) != "" and not ($l | str starts-with "#")}
    | each {|l| let p = ($l | split row " = "); {p: ($p.0 | str trim), m: ($p.1 | str trim)}}
    | uniq-by p)
  let bad = ($rows | where {|r| not ($r.p in $ph) or not ($r.m in $mat)})
  if not ($bad | is-empty) { print $"dropped: ($bad | each {|r| $'($r.p)=($r.m)'} | str join ' ')" }
  # A Phosphor name that is already a Material name needs no alias.
  let ok = ($rows | where {|r| ($r.p in $ph) and ($r.m in $mat) and not (($r.p | str replace -a '-' '_') in $mat)} | sort-by p)
  let body = ($ok | each {|r| $"    \(\"($r.p)\", \"($r.m)\"\),"} | str join "\n")
  $"//! Phosphor names mapped to the Material Symbols icon that means the same thing.\n//! Generated by `scripts/phosphor-aliases.nu` from the hand-curated `phosphor-aliases.txt`.\n\n/// `\(Phosphor name, Material name\)`, sorted by Phosphor name.\npub static PHOSPHOR_ALIASES: &[\(&str, &str\)] = &[\n($body)\n];\n" | save -f src/phosphor_aliases.rs
  print $"($ok | length) pairs"
}
