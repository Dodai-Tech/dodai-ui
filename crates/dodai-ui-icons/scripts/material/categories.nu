#!/usr/bin/env nu
# Regenerate src/material/categories.rs: each icon's category from Google's icon metadata
# (Apache-2.0), with the legacy and Symbols category names merged.
#
#     curl -s "https://fonts.google.com/metadata/icons?key=material_symbols&incomplete=true" | tail -c +6 > icons.json
#     nu crates/dodai-ui-icons/scripts/material/categories.nu icons.json

use ../../../../scripts/icon-names.nu pascal

# Legacy / duplicate category names -> the title shown.
def title [c: string] {
    match ($c | str lowercase) {
        "action" | "actions" | "ui actions" => "Actions",
        "av" | "audio&video" => "Audio & video",
        "communication" | "communicate" => "Communication",
        "device" | "hardware" => "Devices",
        "home" | "household" => "Home",
        "image" | "images" => "Image",
        "maps" | "places" => "Maps & places",
        "transit" | "travel" => "Transit & travel",
        "editor" | "text" => "Text & editor",
        "privacy" => "Privacy",
        "navigation" => "Navigation",
        $o => ($o | str capitalize),
    }
}

def main [meta: string] {
    let src = ($env.FILE_PWD | path dirname | path dirname | path join src material)
    let ours = (open --raw ($src | path join outlined.rs) | parse --regex 'name: "(?P<n>[^"]+)"' | get n | where {|n| not ($n | str ends-with "-fill") } | uniq)
    let rows = (open $meta | get icons | where {|r| $r.name in $ours } | uniq-by name | each {|r| { name: $r.name, cat: (title ($r.categories | first)) } })
    let groups = ($rows | group-by cat | transpose cat names | sort-by cat)
    let body = ($groups | each {|g|
        let names = ($g.names | get name | sort | each {|n| $"MaterialSymbol::(pascal $n)" } | str join ", ")
        $"    \(\"($g.cat)\", &[($names)]\),\n"
    } | str join)
    [
        "// @generated by scripts/categories.nu from Google's Material icon metadata (Apache-2.0). Do not edit.\n\n"
        "use super::MaterialSymbol;\n\n"
        "/// Icons grouped by category (a symbol's filled form is `outlined::get_fill`). Every icon\n"
        "/// is in exactly one category.\n"
        "pub static CATEGORIES: &[(&str, &[MaterialSymbol])] = &[\n"
        $body
        "];\n"
    ] | str join | save --force ($src | path join categories.rs)
    print ($groups | each {|g| { cat: $g.cat, n: ($g.names | length) } })
}
