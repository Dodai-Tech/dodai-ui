#!/usr/bin/env nu
# Regenerates tools/shaders-kernels/src/entries.rs (one GPU entry point per shader) from
# the ShaderInfo tables in crates/dodai-shaders/src/shaders (the host catalogue reads the same
# tables at run time, so there is nothing else to generate).

def main [] {
    let root = ($env.FILE_PWD | path dirname)
    let src = ($root | path join crates dodai-shaders src shaders)
    # catalogue order (families grouped); kernel entry order is separate and stable
    let cat_mods = [cyberpunk blade ghibli ghibli2 dmt pixel2 material matrix retro pixel nature fx extra retro2 ghostty]
    let mods = [cyberpunk blade ghibli ghibli2 dmt material matrix retro retro2 pixel pixel2 nature fx extra ghostty]
    let pat = '(?s)ShaderInfo::(?P<kind>generator|post)\(\s*"(?P<id>\w+)",\s*"(?P<name>[^"]*)",\s*(?P<family>[\w:]+),\s*"(?P<desc>[^"]*)",\s*(?P<func>\w+),?\s*\)'
    let cpat = 'const (?P<name>\w+): Family = (?P<value>Family::\w+);'

    let rows = ($cat_mods | append $mods | uniq | each {|m|
        let text = (open --raw ($src | path join $"($m).rs"))
        let consts = ($text | parse --regex $cpat | reduce --fold {} {|c, acc| $acc | insert $c.name $c.value })
        let found = ($text | parse --regex $pat | each {|r|
            let fam = ($consts | get -o $r.family | default $r.family)
            $r | update family $fam | insert mod $m
        })
        { name: $m, rows: $found }
    } | reduce --fold {} {|e, acc| $acc | insert $e.name $e.rows })

    let ordered = ($mods | each {|m| $rows | get $m } | flatten)
    let gens = ($ordered | where kind == generator)
    let posts = ($ordered | where kind == post)
    let header = "// @generated by scripts/gen-kernels.nu from the ShaderInfo tables. Do not edit.\n\n"
    let entries = (
        $header
        + ($gens | each {|r| $"gen_kernel!\(($r.id), ($r.mod)::($r.func)\);\n" } | str join)
        + ($posts | each {|r| $"post_kernel!\(($r.id), ($r.mod)::($r.func)\);\n" } | str join)
    )
    $entries | save --force ($root | path join tools shaders-kernels src entries.rs)

    print $"($gens | length) generators, ($posts | length) post effects"
}
