# Renders spec/components.toml into Rust source for one target.

# "tag" -> "Tag"
export def pascal [s: string] {
    $s | split row "_" | each {|w| ($w | str substring 0..0 | str uppercase) + ($w | str substring 1..) } | str join
}

# The generated source of one target (a record from [target.*]) for every component.
export def render [spec: record, target: record] {
    let head = "// @generated by scripts/gen-components.nu from spec/components.toml. Do not edit.\n\nuse dodai_core::{Theme, Tone};\n"
    let body = ($spec.component | each {|c|
        let ty = (pascal $c.name)
        let as_option = (($target | get -o transparent) == null)
        let fields = ($c.fields | each {|f|
            let ty = if $f.kind == "opt_color" and $as_option { $"Option<($target.color_ty)>" } else { $target.color_ty }
            $"    /// ($f.name).\n    pub ($f.name): ($ty),\n"
        } | str join)
        let conv = ($c.fields | each {|f|
            if $f.kind == "opt_color" and $as_option {
                $"            ($f.name): tok.($f.name).map\(($target.convert)\),\n"
            } else if $f.kind == "opt_color" {
                $"            ($f.name): tok.($f.name).map_or\(($target.transparent), ($target.convert)\),\n"
            } else {
                $"            ($f.name): ($target.convert)\(tok.($f.name)\),\n"
            }
        } | str join)
        let params = ($c.args | each {|a| $", ($a.name): ($a.ty)" } | str join)
        let call = ($c.args | each {|a| $a.name } | str join ", ")
        [
            $"\n/// ($c.doc)"
            "#[derive(Debug, Clone, Copy, PartialEq)]"
            $"pub struct ($ty)Style {"
            ($fields | str trim --right)
            "}\n"
            $"impl ($ty)Style {"
            $"    /// The style of `theme` for these arguments."
            $"    pub fn of\(theme: &Theme($params)\) -> Self {"
            $"        let tok = theme.($c.resolver)\(($call)\);"
            "        Self {"
            ($conv | str trim --right)
            "        }"
            "    }"
            "}"
        ] | str join "\n"
    } | str join "\n")
    $head + $body + "\n"
}
