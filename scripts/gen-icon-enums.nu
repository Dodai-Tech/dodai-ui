#!/usr/bin/env nu
# Typed icon names, generated from the committed icon data (no upstream needed):
#   crates/dodai-icon-id/src/id.rs          `IconId`: the shared vocabulary = every Dodai
#                                           (Cyberpunk) name + every Phosphor name
#   crates/dodai-material-icons/src/symbol.rs  `MaterialSymbol`: Material's own catalogue
# Run from the repo root after regenerating icon data: `nu scripts/gen-icon-enums.nu`.
use icon-names.nu [pascal key]

# Outline names of a generated icon table (`Icon { name: "x", ... }`), no `-fill` forms.
def table-names [path: string] {
  open $path | lines
    | where {|l| $l | str starts-with '    Icon { name: "'}
    | each {|l| $l | parse -r 'name: "(?<n>[^"]+)"' | get n.0}
    | where {|n| not ($n | str ends-with '-fill')}
}

# Names of the hand-drawn Cyberpunk pack: `Variant, "name", "group" => ...`.
def cyberpunk-names [] {
  open crates/dodai-cyberpunk-icons/src/lib.rs | lines
    | each {|l| $l | parse -r '^\s+[A-Z]\w*, "(?<n>[a-z0-9_-]+)", "\w+" =>' | get -o n.0 | default null}
    | compact
}

def emit [enum_name: string, doc: string, names: list<string>, path: string, from_key: bool] {
  let rows = ($names | each {|n| {k: (key $n), v: (pascal $n)}} | uniq-by k | sort-by k)
  let dup = ($rows | group-by v | transpose v items | where {|g| ($g.items | length) > 1})
  if not ($dup | is-empty) { error make {msg: $"colliding variants: ($dup | get v | str join ' ')"} }
  if ($rows | any {|r| $r.v == "Self"}) { error make {msg: "a name maps to `Self`"} }
  let variants = ($rows | each {|r| $"    ($r.v),"} | str join "\n")
  let all = ($rows | each {|r| $"    ($enum_name)::($r.v),"} | str join "\n")
  let arms = ($rows | each {|r| $"            Self::($r.v) => \"($r.k)\","} | str join "\n")
  let keys = if $from_key {
    let m = ($rows | each {|r| $"            \"($r.k)\" => Some\(Self::($r.v)\),"} | str join "\n")
    $"\n    /// The variant for a normalised key \(`snake_case`\); for the icon crates' internal tables.\n    #[doc\(hidden\)]\n    pub fn from_key\(key: &str\) -> Option<Self> {\n        match key {\n($m)\n            _ => None,\n        }\n    }\n"
  } else { "" }
  $"// @generated by scripts/gen-icon-enums.nu. Do not edit.\n\n#![allow\(missing_docs, clippy::enum_variant_names\)]\n\n/// ($doc)\n#[derive\(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord\)]\npub enum ($enum_name) {\n($variants)\n}\n\nimpl ($enum_name) {\n    /// Every variant, in name order.\n    pub const ALL: &'static [($enum_name)] = &[\n($all)\n    ];\n\n    /// The icon's name \(`snake_case`\), for labels, search and file names.\n    pub const fn name\(self\) -> &'static str {\n        match self {\n($arms)\n        }\n    }\n($keys)}\n" | save -f $path
  print $"($enum_name): ($rows | length) variants"
}

# `Icon::House`: one associated constant per icon on a toolkit's builder, so the icon reads as a
# name (`Icon::House.size(24.0)`) instead of `Icon::new(IconId::House)`.
def emit-consts [ty: string, ctor: string, enum_name: string, names: list<string>, path: string] {
  let rows = ($names | each {|n| {k: (key $n), v: (pascal $n)}} | uniq-by k | sort-by k)
  let body = ($rows | each {|r| $"    pub const ($r.v): ($ty) = ($ty)::($ctor)\(($enum_name)::($r.v)\);"} | str join "\n")
  $"// @generated by scripts/gen-icon-enums.nu. Do not edit.\n\n#![allow\(non_upper_case_globals, missing_docs\)]\n\nuse super::*;\n\nimpl ($ty) {\n($body)\n}\n" | save -f $path
  print $"($ty): ($rows | length) constants"
}

let vocab = ((cyberpunk-names) ++ (table-names crates/dodai-icons/src/phosphor/regular.rs))
emit "IconId" "An icon of the shared vocabulary: every design system draws every one, in its own style." $vocab crates/dodai-icon-id/src/id.rs true
emit "MaterialSymbol" "A Material Symbols catalogue icon." (table-names crates/dodai-material-icons/src/outlined.rs) crates/dodai-material-icons/src/symbol.rs false

emit-consts "Icon" "of" "IconId" $vocab crates/dodai-gpui/src/icon_names.rs
